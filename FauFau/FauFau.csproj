<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>

    <!-- NuGet Package Information -->
    <PackageId>FauFau</PackageId>
    <Authors>The Melding Wars</Authors>
    <Description>FauFau is a library for manipulating FireFall's various file formats and protocols</Description>
    <RepositoryUrl>https://github.com/themeldingwars/FauFau</RepositoryUrl>
    <PackageProjectUrl>https://github.com/themeldingwars/FauFau</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageTags>firefall;mmo;protocol;file-format;matrix;sdb</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="[0.50.4,)" />
    <PackageReference Include="TMW.Bitter" Version="[1.1.10,)" />
    <PackageReference Include="Nerdbank.GitVersioning" Version="3.10.94">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
