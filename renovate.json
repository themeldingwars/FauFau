{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": ["nuget"],
  "dependencyDashboard": false,
  "packageRules": [
    {
      "description": "Default cooldown for all NuGet packages",
      "matchDatasources": ["nuget"],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "No cooldown for TMW's own packages",
      "matchDatasources": ["nuget"],
      "matchPackageNames": [
        "Aero.Gen",
        "FauCap",
        "FauCapParser",
        "FauFau",
        "ImTool",
        "TMW.Bitter"
      ],
      "minimumReleaseAge": "0 days"
    },
    {
      "description": "Keep the System.IO.Hashing floor on 8.x so net8.0 consumers don't pull in newer runtime packages",
      "matchDatasources": ["nuget"],
      "matchPackageNames": ["System.IO.Hashing"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
